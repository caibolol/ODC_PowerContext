# 后端模式：embedded=嵌入式 seekdb（默认，零外部服务）；server=连接 seekdb 服务端
DB_MODE=embedded
# 嵌入式数据目录
#EMBEDDED_DB_DIR=./.evidencedesk-seekdb
# PowerContext 服务地址
#POWERCONTEXT_URL=http://127.0.0.1:18752
# 设为 1 时 npm run demo 跳过 PowerContext 自检
#SKIP_CONTEXT=1

# 数据库连接配置（仅 DB_MODE=server 使用）
DB_HOST=127.0.0.1
DB_PORT=2881
DB_NAME=test
DB_USER=root
DB_PASSWORD=

# 服务器配置
HOST=127.0.0.1
PORT=18748
NODE_ENV=development
